; Standalone wrapper project for The Causal Clock mini-game.
; Everything the mini-game needs lives in res://minigames/causal_clock/ —
; copy that folder into another Godot 4.3 project to embed it.

config_version=5

[application]

config/name="The Causal Clock"
run/main_scene="res://minigames/causal_clock/scenes/causal_clock_title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.027, 0.027, 0.043, 1)
