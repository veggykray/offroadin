hold_after = 0.4

[sub_resource type="Resource" id="Resource_g45ys"]
script = ExtResource("1_wpdtv")
text = "Oh! [recoil]Oh, hello. Hello. [glance_away]Sorry."
expression = &"surprised"
hold_after = 0.4
text_speed = 1.3

[sub_resource type="Resource" id="Resource_i7mbv"]
script = ExtResource("1_wpdtv")
text = "[double_blink]Are you... [look_at_player]are you going to open me?"
expression = &"sad"
hold_after = 0.5
text_speed = 1.2

[sub_resource type="Resource" id="Resource_ucwg8"]
script = ExtResource("1_wpdtv")
text = "[widen]Please be gentle with the handle."
expression = &"surprised"
expression_intensity = 0.6
hold_after = 0.4
text_speed = 1.3

[sub_resource type="Resource" id="Resource_7oaae"]
script = ExtResource("1_wpdtv")
text = "[glance:down]It's just that nobody ever comes back out."
expression = &"sad"
hold_after = 0.5
text_speed = 1.1

